# Copy to .env and fill in. Never commit .env (SHR-005).

# --- Postgres (local compose) ---
POSTGRES_USER=switchboard
POSTGRES_PASSWORD=switchboard
POSTGRES_DB=switchboard
DATABASE_URL=postgresql://switchboard:switchboard@localhost:5432/switchboard

# --- Model providers (LiteLLM reads these; M1) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Embeddings (KB retrieval). Use EMBED_MODEL=hash to run without an OpenAI key ---
EMBED_MODEL=openai/text-embedding-3-small

# --- Langfuse Cloud (default tracing) ---
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Safety defaults ---
DEMO_INTEGRATIONS=mock          # mock | real
OUTBOUND_MODE=off               # off | allowlist | approve_first
DAILY_USD_CAP=5
OUTBOUND_ALLOWLIST=             # e.g. +9198xxxxxxxx,you@example.org,@example.org (allowlist mode)

# --- Real integrations (only read when DEMO_INTEGRATIONS=real) ---
SLACK_BOT_TOKEN=                # xoxb-..., scope chat:write; invite the bot to each channel
SLACK_CHANNELS=                 # #leads=C0123,#ops-alerts=C0456,#guest-support=C0789
WHATSAPP_PHONE_NUMBER_ID=       # Meta test number's phone number ID (not the WABA ID)
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en
GHL_TOKEN=                      # GoHighLevel Private Integration token (contacts.write)
GHL_LOCATION_ID=
EMAIL_FROM=Palmgrove Stays <hello@palmgrove.test>   # replies land in Mailpit, :8025
